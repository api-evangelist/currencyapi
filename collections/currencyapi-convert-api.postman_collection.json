          "name": "Convert a value between currencies",
          "request": {
            "name": "Convert a value between currencies",
            "description": {
              "content": "Converts a monetary value from the base currency into one or more target currencies, using today's rates or the rates of a given historical date.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "convert"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "value",
                  "value": "<number>",
                  "description": "(Required) The value you want to convert."
                },
                {
                  "disabled": false,
                  "key": "date",
                  "value": "<date>",
                  "description": "Optional historical date to convert with (format: 2021-12-31). Defaults to the latest rates."
                },
                {
                  "disabled": false,
                  "key": "base_currency",
                  "value": "USD",
                  "description": "The base currency to which all results are behaving relative to. Defaults to USD."
                },
                {
                  "disabled": false,
                  "key": "currencies",
                  "value": "<string>",
                  "description": "A list of comma-separated currency codes you want to receive (e.g. EUR,USD,CAD). Defaults to all available currencies."
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "The type of currency you want to get. Defaults to all types."
                }
              ],
              "variable": []
            },
            "header": [
