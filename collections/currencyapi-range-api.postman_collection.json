      },
      "item": [
        {
          "id": "0434fdc4-0727-42b5-85ef-f724f5e407e3",
          "name": "Range (time-series) exchange rates",
          "request": {
            "name": "Range (time-series) exchange rates",
            "description": {
              "content": "Returns exchange rate data for a datetime range in a single call. Accuracy constraints - day covers up to 366 days of history; hour allows a maximum 7-day range up to 3 months back; quarter_hour allows a maximum 24-hour range up to 7 days back; minute allows a maximum 6-hour range up to 7 days back.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "range"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "datetime_start",
                  "value": "<dateTime>",
                  "description": "(Required) ISO8601 datetime for the start of the range (format: 2022-12-01T00:00:00Z)."
                },
                {
                  "disabled": false,
                  "key": "datetime_end",
                  "value": "<dateTime>",
                  "description": "(Required) ISO8601 datetime for the end of the range (format: 2022-12-31T23:59:59Z)."
                },
                {
                  "disabled": false,
                  "key": "accuracy",
                  "value": "day",
                  "description": "Accuracy of the time-series data points."
                },
                {
                  "disabled": false,
                  "key": "base_currency",
                  "value": "USD",
                  "description": "The base currency to which all results are behaving relative to. Defaults to USD."
                },
                {
                  "disabled": false,
                  "key": "currencies",
                  "value": "<string>",
                  "description": "A list of comma-separated currency codes you want to receive (e.g. EUR,USD,CAD). Defaults to all available currencies."
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "The type of currency you want to get. Defaults to all types."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
