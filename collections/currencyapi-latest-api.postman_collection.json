          "request": {
            "name": "Latest exchange rates",
            "description": {
              "content": "Returns the latest exchange rates for the given base currency against all available currencies or a selected list. Rate freshness depends on plan - daily on Free, hourly on Small, every 60 seconds on Medium and above.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "latest"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "base_currency",
                  "value": "USD",
                  "description": "The base currency to which all results are behaving relative to. Defaults to USD."
                },
                {
                  "disabled": false,
                  "key": "currencies",
                  "value": "<string>",
                  "description": "A list of comma-separated currency codes you want to receive (e.g. EUR,USD,CAD). Defaults to all available currencies."
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
